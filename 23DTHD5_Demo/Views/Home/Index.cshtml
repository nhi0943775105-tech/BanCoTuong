                <strong>{{ statusText }}</strong>
                <span v-if="roleText" class="game-role">{{ roleText }}</span>
                <span v-if="notice" class="game-notice">{{ notice }}</span>
                <button v-if="gameState && gameState.finished && myColor"
                        type="button"
                        class="game-rematch"
                        @@click="rematch">
                    Ván mới
                </button>
            </div>

            <div class="chess-board"
                 ref="board"
                 @@click="moveTo">

                <img class="board-image"
                     src="/images/bancotuong.jpg"
                     draggable="false" />


                <span v-for="target in legalTargets"
                      :key="'t' + target[0] + '-' + target[1]"
                      class="legal-dot"
                      :style="getCellStyle(target)"
                      @@click.stop="movePiece(selectedPiece, target[0], target[1])"></span>

                <img v-for="piece in pieces"
                     :key="piece.id"
                     :src="'/images/' + piece.file"
                     class="piece"
                     :class="{
                        'in-check': isCheckedGeneral(piece),
                        selected:
                            selectedPiece?.id === piece.id
                     }"
                     :style="getPieceStyle(piece)"
                     @@click.stop="selectPiece(piece)"
                     draggable="false" />

            </div>

        </div>



        <!-- ========================= -->
        <!-- CHAT -->
        <!-- ========================= -->

        <div class="chat-panel">

            <div class="chat-header">

                Phòng chat

                <small>
                    Mã phòng: {{ roomId }}
                </small>

            </div>


            <!-- DANH SÁCH TIN NHẮN -->

            <div class="chat-messages"
                 ref="chatMessages">

                <div v-if="messages.length === 0"
                     class="no-message">

                    Chưa có tin nhắn

                </div>


                <div v-for="(item, index) in messages"
                     :key="index"
                     class="chat-message">

                    <strong>
                        {{ item.userName }}:
                    </strong>

                    <span>
                        {{ item.message }}
                    </span>

                </div>

            </div>


            <!-- NHẬP CHAT -->

            <div class="chat-input">

                <input type="text"
                       v-model="chatMessage"
                       placeholder="Nhập tin nhắn..."
                       @@keyup.enter="sendMessage" />


                <button type="button"
                        @@click="sendMessage">

                    Gửi

                </button>

            </div>

        </div>

    </div>

    <div class="video-call">

        <div class="video-container">

            <div>
                <p>Camera của bạn</p>

                <video ref="localVideo"
                       autoplay
                       muted
                       playsinline>
                </video>
            </div>


            <div>
                <p>Đối thủ</p>

                <video ref="remoteVideo"
                       autoplay
                       playsinline>
                </video>
            </div>

        </div>


        <button type="button"
                @@click="startCall">

            Gọi video

        </button>

    </div>

</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script src="/js/auth.js" asp-append-version="true"></script>
<script src="/js/lobby.js" asp-append-version="true"></script>
<script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
<script src="/js/cotuong.js" asp-append-version="true"></script>
