<style>
    .game-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 25px;
        width: 100%;
        margin-top: 20px;
    }


    /* ==========================
       BÀN CỜ
       ========================== */

    .game-status {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 14px;
        margin: 6px 0 12px;
        padding: 8px 12px;
        background: #173c3a;
        color: #f8f3e8;
        border-radius: 3px;
        font-size: 14px;
    }

    .game-status-check {
        background: #bf4f45;
    }

    .game-role {
        color: #eac675;
        font-size: 12px;
    }

    .game-notice {
        flex-basis: 100%;
        color: #ffd9d4;
        font-size: 12px;
    }

    .game-rematch {
        margin-left: auto;
        border: 0;
        border-radius: 2px;
        padding: 4px 12px;
        background: #eac675;
        color: #173c3a;
        font-weight: 700;
        cursor: pointer;
    }

    .legal-dot {
        position: absolute;
        width: 3.4%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background: rgba(23, 60, 58, .55);
        box-shadow: 0 0 0 3px rgba(234, 198, 117, .6);
        cursor: pointer;
        z-index: 20;
    }

    .piece.in-check {
        filter: drop-shadow(0 0 8px #bf4f45);
    }

    .board-section {
        flex: 0 1 700px;
    }


    .chess-board {
        position: relative;
        width: 100%;
        max-width: 700px;
    }


    .board-image {
        display: block;
        width: 100%;
        height: auto;
    }


    .piece {
        position: absolute;
        width: 7%;
        height: auto;
        transform: translate(-50%, -50%);
        cursor: pointer;
        z-index: 10;
        transition: left 0.2s ease, top 0.2s ease;
    }


        .piece.selected {
            filter: drop-shadow( 0 0 6px blue );
            transform: translate(-50%, -50%) scale(1.15);
        }


    /* ==========================
       CHAT
       ========================== */

    .chat-panel {
        width: 320px;
        height: 600px;
        display: flex;
        flex-direction: column;
        border: 1px solid #ccc;
        border-radius: 8px;
        background: white;
        overflow: hidden;
    }


    .chat-header {
        padding: 15px;
        font-size: 18px;
        font-weight: bold;
        border-bottom: 1px solid #ddd;
    }


        .chat-header small {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            font-weight: normal;
            color: #777;
        }


    .chat-messages {
        flex: 1;
        padding: 12px;
        overflow-y: auto;
        text-align: left;
    }


    .chat-message {
        padding: 7px 5px;
        border-bottom: 1px solid #eee;
        word-break: break-word;
    }


    .no-message {
        margin-top: 20px;
        text-align: center;
        color: #999;
    }


    /* ==========================
       INPUT CHAT
       ========================== */

    .chat-input {
        display: flex;
        padding: 10px;
        gap: 8px;
        border-top: 1px solid #ddd;
    }


        .chat-input input {
            flex: 1;
            min-width: 0;
            padding: 9px;
            border: 1px solid #ccc;
            border-radius: 5px;
            outline: none;
        }


        .chat-input button {
            padding: 9px 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

    .video-call {
        margin-top: 20px;
    }

    .video-container {
        display: flex;
        gap: 10px;
    }

        .video-container video {
            width: 250px;
            height: 190px;
            background: black;
            object-fit: cover;
            border-radius: 5px;
        }

    .video-call button {
        margin-top: 10px;
        padding: 10px 20px;
        cursor: pointer;
    }
</style>
